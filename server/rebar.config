{erl_opts, [
    {parse_transform, lager_transform},
    warn_export_all,
    warn_export_vars,
    warn_untyped_record,
    warn_unused_import,
    warnings_as_errors,
    nowarn_unused_vars
]}.

{deps, [
        {lager, ".*",
            {git, "https://github.com/erlang-lager/lager.git", {ref, "e6b31784e65b838a10d0a533f4b838da8029e402"}}},
        {hamcrest, ".*",
            {git, "https://github.com/hyperthunk/hamcrest-erlang", {ref, "a8578932014c86fe395982fa3151d48897b9c37f"}}},
        {cowboy, ".*",
            {git, "https://github.com/ninenines/cowboy.git", {ref, "a8c717718a3f4dd7b4bc67fe7bebe3a4e7a7ed74"}}},
        {jiffy, ".*",
            {git, "https://github.com/davisp/jiffy.git", {tag, "1.1.2"}}},
        {gen_smtp, ".*",
            {git, "https://github.com/Vagabond/gen_smtp.git", {tag, "1.3.0"}}},
        {meck, ".*",
            {git, "https://github.com/eproxus/meck.git", {tag, "0.8.13"}}},
        {mzbench_language, ".*",
            {rsync, "../common_apps/mzbench_language/"}},
        {mzbench_utils, ".*",
            {rsync, "../common_apps/mzbench_utils/"}},
        {erlcloud, ".*",
            {git, "https://github.com/erlcloud/erlcloud.git", {tag, "3.1.7"}}},
        {hdr_histogram, ".*",
            {git, "https://github.com/HdrHistogram/hdr_histogram_erl.git", {ref, "39991d346382e0add74fed2e8ec1cd5666061541"}}}
        ]}.

{deps_dir, "deps"}.

{lib_dirs, ["deps"]}.

{eunit_opts, [verbose]}.

{minimum_otp_vsn, "17.0"}.

{plugins, [
    {rebar_rsync_deps, ".*", {git, "https://github.com/ioolkos/rebar3_rsync_resource.git", {ref, "2bdf3e916e66c35f2b5f9b313f9012f277de0539"}}}
    ]}.

{dialyzer, [
    {warnings, [
        error_handling,
        no_undefined_callbacks,
        race_conditions,
        underspecs,
        unmatched_returns
        ]},
    {plt_extra_apps, [cowboy, cowlib]}
    ]}.

{relx, [
    {release, {mzbench_api, "0.5.8"},
        [mzbench_api]},
    {vm_args, "rel/files/vm.args"},
    {sys_config, "rel/files/sys.config"},
    {include_erts, true},
    {extended_start_script, true}
    ]}.

{pre_hooks, [{"(linux|darwin|solaris)", compile, "sed \"s/{{vsn}}/`cat $REBAR_DEPS_DIR/mzbench_api/priv/version`/g\" \"$REBAR_DEPS_DIR/mzbench_api/priv/http_root/index.html.template\" > \"$REBAR_DEPS_DIR/mzbench_api/priv/http_root/index.html\""}]}.
